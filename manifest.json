{
  "manifest_version": 3,
  "name": "Right to Left for Z-RKH",
  "version": "0.1",
  "description": "راست چنین کننده صفحات",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "یادگاری از سید!"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": ["content.js"]
    }
  ]
}